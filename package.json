{"author":"Gaurav Kumar Yadav","bin":{"actions-doctor":"./dist/cli.js"},"bugs":{"url":"https://github.com/xgauravyaduvanshii/actions-yaml-doctor/issues"},"dependencies":{"yaml":"^2.6.1"},"description":"Beginner-focused, plain-English checker for GitHub Actions workflow YAML and composite actions — syntax, schema, expressions, secrets, reusable workflows, action versions and matrix validation, fully offline.","devDependencies":{"@types/node":"^22.10.2","typescript":"^5.7.2","vitest":"^2.1.8"},"engines":{"node":">=18"},"files":["dist","README.md","LICENSE"],"homepage":"https://github.com/xgauravyaduvanshii/actions-yaml-doctor#readme","keywords":["github-actions","yaml","workflow","cli","ci","lint"],"license":"MIT","main":"./dist/cli.js","name":"actions-yaml-doctor","repository":{"type":"git","url":"https://github.com/xgauravyaduvanshii/actions-yaml-doctor.git"},"scripts":{"build":"tsc -p tsconfig.build.json","check":"node dist/cli.js check .github/workflows --strict","lint":"tsc --noEmit","test":"vitest run","test:watch":"vitest"},"type":"module","version":"0.2.0"}